#compdef envup
# zsh completion for envup. Auto-loaded by the zsh module's tools file.

_envup() {
    local -a subcommands
    subcommands=(
        'install:Install modules (by profile or by name)'
        'uninstall:Remove installed modules'
        'upgrade:Pull latest config and reinstall'
        'status:Show the real state of each module'
        'doctor:Health-check this machine (--fix to repair)'
        'adopt:Move third-party edits out of the repo'
        'clean:Clear caches declared in each module meta.sh'
        'log:Show the latest command log'
        'version:Print the envup version'
        'help:Show usage'
    )

    # Locate the envup repo so we can list modules / profiles dynamically.
    local _bin _home
    _bin=$(whence -p envup 2>/dev/null) || _bin=""
    [[ -n "$_bin" ]] && _home=$(dirname "$(readlink -f "$_bin" 2>/dev/null || echo "$_bin")")

    local -a _modules _profiles
    [[ -n "$_home" && -d "$_home/modules" ]]  && _modules=("$_home"/modules/*(N/:t))
    [[ -n "$_home" && -d "$_home/profiles" ]] && _profiles=("$_home"/profiles/*.sh(N:t:r))

    _arguments -C '1: :->subcmd' '*::arg:->args'

    case $state in
        subcmd) _describe -t commands 'envup command' subcommands ;;
        args)
            case $words[1] in
                install)
                    _arguments \
                        '--profile[Use a profile]:profile:('"${_profiles[*]}"')' \
                        '-p[Use a profile]:profile:('"${_profiles[*]}"')' \
                        '--dry-run[Preview]' '-n[Preview]' \
                        '--help[Show help]' \
                        '*:module:('"${_modules[*]}"')'
                    ;;
                upgrade)
                    # --ref takes a tag or a branch, and the repo already knows
                    # which ones exist — offering the list is the difference
                    # between pinning a release and guessing at its name.
                    local -a _refs
                    [[ -n "$_home" ]] && _refs=(${(f)"$(git -C "$_home" for-each-ref \
                        --format='%(refname:short)' refs/tags refs/heads 2>/dev/null)"})
                    _arguments \
                        '--profile[Use a profile]:profile:('"${_profiles[*]}"')' \
                        '-p[Use a profile]:profile:('"${_profiles[*]}"')' \
                        '--ref[Check out a specific tag or branch]:ref:('"${_refs[*]}"')' \
                        '-r[Check out a specific tag or branch]:ref:('"${_refs[*]}"')' \
                        '--dry-run[Preview]' '-n[Preview]' \
                        '--keep-going[Continue even if the source cannot be updated]' \
                        '-k[Continue even if the source cannot be updated]' \
                        '--help[Show help]' \
                        '*:module:('"${_modules[*]}"')'
                    ;;
                uninstall)
                    _arguments \
                        '--all[Remove every installed module]' \
                        '--dry-run[Preview]' '-n[Preview]' \
                        '--help[Show help]' \
                        '*:module:('"${_modules[*]}"')'
                    ;;
                clean)
                    _arguments \
                        '--all[Clean every module]' \
                        '--dry-run[Preview]' '-n[Preview]' \
                        '--help[Show help]' \
                        '*:module:('"${_modules[*]}"')'
                    ;;
                doctor)
                    _arguments \
                        '--fix[Repair what can be repaired]' \
                        '--authoring[Check module authoring conventions instead]' \
                        '*--module[Restrict to one module]:module:('"${_modules[*]}"')' \
                        '--help[Show help]' \
                        '*:module:('"${_modules[*]}"')'
                    ;;
                adopt)
                    # Only managed files can drift, so that is the whole candidate set.
                    local -a _managed
                    [[ -n "$_home" ]] && _managed=("$_home"/modules/*/files/**/*(N.))
                    _managed=(${_managed#$_home/})
                    _arguments \
                        '--dry-run[Preview]' '-n[Preview]' \
                        '--help[Show help]' \
                        '*:path:('"${_managed[*]}"')'
                    ;;
                status) _arguments '--json[Machine-readable output]' '--help[Show help]' ;;
                log)    _arguments '--tail[Follow live]' '-f[Follow live]' '--help[Show help]' ;;
            esac
            ;;
    esac
}

_envup "$@"
