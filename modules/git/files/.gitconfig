# Git configuration (shared across machines)
# Linked into place by `envup install git`.
#
# Per-user identity (user.name / user.email) lives in ~/.gitconfig.local,
# which is NOT in this repo. The [include] section at the bottom pulls it in.
# `envup install git` will create that file for you on first install.

[core]
    autocrlf = input

# core.editor is deliberately NOT set here. This file is shared by every
# machine, and hard-coding `nvim` broke `git commit` on any of them that did not
# have it — the minimal profile does not install nvim at all. Unset, git falls
# back to $GIT_EDITOR / $VISUAL / $EDITOR, and ~/.zshrc.d/30-env.zsh already
# picks the first of nvim/vim/vi that exists *on this machine*. Runtime
# detection beats a guess committed to a repo. Same reason there is no
# merge.tool / diff.tool: `git mergetool` finds an installed one by itself.

# How delta is turned on: `envup install git` detects it and writes the [pager]
# and [interactive] sections into ~/.gitconfig.envup, included below. Settings
# for delta live here because they are inert when delta is absent.
[delta]
    navigate = true
    line-numbers = true
    side-by-side = false
    syntax-theme = Dracula
    dark = true

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    default = current
    autoSetupRemote = true

[fetch]
    prune = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[alias]
    # Status
    st = status -sb
    s = status -sb
    
    # Log
    lg = log --oneline --graph --decorate -20
    lga = log --oneline --graph --decorate --all -20
    ll = log --pretty=format:'%C(yellow)%h%Creset %s %C(green)(%cr)%Creset %C(blue)<%an>%Creset' -20
    
    # Branch
    br = branch -vv
    co = checkout
    cb = checkout -b
    
    # Commit
    cm = commit -m
    ca = commit --amend
    can = commit --amend --no-edit
    
    # Diff
    df = diff
    dfs = diff --staged
    
    # Reset
    unstage = reset HEAD --
    undo = reset --soft HEAD~1
    
    # Misc
    alias = config --get-regexp ^alias\\.
    last = log -1 HEAD --stat

[color]
    ui = auto
    branch = auto
    diff = auto
    status = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "status"]
    added = green
    changed = yellow
    untracked = red

# Trust any directory. Convenient inside Docker / shared hosts where the
# repo is owned by a different uid than the running user, which would
# otherwise trigger "dubious ownership". Per-user safe.directory entries
# (more restrictive) belong in ~/.gitconfig.local.
[safe]
    directory = *

# Three layers on top of the shared config above, weakest first — git applies
# includes in order, so the last one to set a key wins.
#
#   ~/.gitconfig.envup  generated by `envup install git` from what this machine
#                       actually has (the delta pager). Rewritten every install,
#                       removed on uninstall — do not edit it.
#   ~/.gitconfig.host   symlink to modules/git/files/hosts/<hostname>.gitconfig,
#                       IN the repo: committed, so per-machine settings sync and
#                       survive a rebuild. Beats the generated file.
#   ~/.gitconfig.local  NOT in the repo: your identity, tokens, work-only
#                       settings. Beats everything.
#
# A missing include is silently ignored, so all three are optional.
[include]
    path = ~/.gitconfig.envup
    path = ~/.gitconfig.host
    path = ~/.gitconfig.local
