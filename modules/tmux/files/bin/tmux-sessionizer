#!/usr/bin/env bash
# tmux-sessionizer — pick a project, land in a tmux session named after it.
#
# The friction this removes: switching projects used to mean remembering which
# numbered session you had put it in, or opening a new one and cd-ing back. Here
# the session name *is* the project name, and picking an existing project
# re-attaches instead of making a second copy of it.
#
#   tmux-sessionizer            fzf over every project root
#   tmux-sessionizer <dir>      skip the picker, go straight there
#   tmux-sessionizer --launch   what `prefix f` runs; opens one of the above
#
# Bound to `prefix + f` inside tmux, and to `ts` in zsh. Works from outside tmux
# too (it attaches rather than switching).
set -uo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/envup/project-dirs"

# $ENVUP_TS_PAUSE is set by --launch, and only by it. Whichever container the
# key binding opens — a popup or a throwaway window — tmux tears it down the
# instant the command exits, so an error message would be on screen for a few
# milliseconds and `prefix f` would look like a key that does nothing at all.
# From the shell (`ts`) there is nothing to lose, so it does not pause there.
die() {
    printf '%s\n' "tmux-sessionizer: $*" >&2
    if [[ -n "${ENVUP_TS_PAUSE:-}" && -r /dev/tty ]]; then
        printf 'press Enter to close...' >&2
        read -r _ </dev/tty || true
    fi
    exit 1
}

# Where projects live, first source that answers:
#
#   $ENVUP_PROJECT_DIRS   colon-separated globs — escape hatch, and what the
#                         tests use
#   ~/.config/envup/project-dirs   one glob per line, '#' comments. A file
#                         rather than an exported variable because a tmux key
#                         binding runs under the tmux *server's* environment,
#                         which never saw your .zshrc.
#   built-in defaults     so most machines need no configuration at all
roots() {
    if [[ -n "${ENVUP_PROJECT_DIRS:-}" ]]; then
        printf '%s\n' "${ENVUP_PROJECT_DIRS//:/$'\n'}"
    elif [[ -r "$CONF" ]]; then
        sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^$/d' "$CONF"
    else
        printf '%s\n' \
            "$HOME/work/*" "$HOME/src/*" "$HOME/projects/*" \
            "$HOME/dev/*"  "$HOME/repos/*" "$HOME/go/src/*/*"
    fi
}

candidates() {
    local pat d
    while IFS= read -r pat; do
        [[ -n "$pat" ]] || continue
        pat="${pat/#\~/$HOME}"
        # Unquoted on purpose — the whole point of an entry is that it globs.
        # shellcheck disable=SC2086
        for d in $pat; do [[ -d "$d" ]] && printf '%s\n' "$d"; done
    done < <(roots) | awk '!seen[$0]++'
}

command -v tmux >/dev/null 2>&1 || die "tmux is not installed here"

# ---- --launch: how `prefix f` gets here ----------------------------------
#
# A key binding runs under `run-shell`, which has no terminal at all, so the
# only thing it can do is ask tmux to open one and run this script again inside
# it. There are two ways to open one:
#
#   display-popup   tmux 3.2 and up — a box over the current pane, nothing
#                   in your layout moves and nothing is left behind
#   new-window      everything older — a throwaway window, as before
#
# The choice is made here, at keypress time, rather than with an `if-shell` in
# .tmux.conf. Same answer either way on a given machine, but this one also
# survives upgrading tmux without re-sourcing the config — and it is testable,
# which an if-shell condition is not.

# `tmux -V` says "tmux 3.2a", sometimes "tmux next-3.5", and on OpenBSD "tmux
# openbsd-7.4" — a number that tracks the OS release and says nothing about the
# features. Anything we cannot parse reads as too old, which is the branch that
# works everywhere.
tmux_at_least() {
    local v
    v="$(tmux -V 2>/dev/null)" || return 1
    v="${v##* }"; v="${v#next-}"
    [[ "$v" =~ ^([0-9]+)\.([0-9]+) ]] || return 1
    (( BASH_REMATCH[1] > $1 || (BASH_REMATCH[1] == $1 && BASH_REMATCH[2] >= $2) ))
}

# The path to re-enter ourselves by. run-shell goes through `sh -c`, which
# expands the ~ in the binding, so $0 is normally already absolute — but a
# relative call has to keep working, because tmux runs the command from the
# pane's directory and not from ours.
self_path() {
    case "$0" in
        /*) printf '%s\n' "$0" ;;
        *)  printf '%s/%s\n' "$(cd -- "$(dirname -- "$0")" && pwd)" "$(basename -- "$0")" ;;
    esac
}

launch() {
    [[ -n "${TMUX:-}" ]] || die "--launch is for the tmux key binding; run 'ts' instead"

    local cmd popup
    cmd="ENVUP_TS_PAUSE=1 $(printf '%q' "$(self_path)")"

    # Set ENVUP_TS_POPUP to 0 or 1 to overrule the version check — from a
    # host.conf, `tmux set-environment -g ENVUP_TS_POPUP 0`.
    popup="${ENVUP_TS_POPUP:-}"
    if [[ "$popup" != 0 && "$popup" != 1 ]]; then
        if tmux_at_least 3 2; then popup=1; else popup=0; fi
    fi

    if (( popup )); then
        # -E closes the popup when the command exits. No -T: the title flag only
        # arrived in 3.3, and the whole point of the check is to work on 3.2.
        tmux display-popup -E -w 60% -h 60% "$cmd"
    else
        tmux new-window -n sessionizer "$cmd"
    fi
}

if [[ "${1:-}" == --launch ]]; then
    launch
    exit $?
fi

if (( $# > 0 )); then
    selected="$1"
    [[ -d "$selected" ]] || die "not a directory: $selected"
else
    list="$(candidates)"
    if [[ -z "$list" ]]; then
        die "no project directories found. List yours, one glob per line, in $CONF"
    fi
    command -v fzf >/dev/null 2>&1 || die "fzf is not installed here (envup install fzf)"
    selected="$(printf '%s\n' "$list" | fzf --prompt='project> ' --height=100% --reverse)"
    [[ -n "$selected" ]] || exit 0      # picker cancelled — not an error
fi

selected="${selected%/}"
# tmux treats '.' and ':' as address separators in a session name.
name="$(basename "$selected" | tr '.:' '__')"

# '=' is tmux's exact-match prefix: without it `has-session -t api` also matches
# a session called 'api-gateway', and you would be sent to the wrong project.
tmux has-session -t "=$name" 2>/dev/null ||
    tmux new-session -d -s "$name" -c "$selected" ||
    die "could not create session '$name'"

if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "=$name"
else
    tmux attach-session -t "=$name"
fi
