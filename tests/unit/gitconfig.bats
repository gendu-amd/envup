#!/usr/bin/env bats
# Shared Git config must not assume machine-local tools or identity.

load '../test_helper'

setup() {
    common_setup
    GITCFG="$REPO_ROOT/modules/git/files/.gitconfig"
    GENERATED="$HOME/.gitconfig.envup"
    source "$REPO_ROOT/modules/git/meta.sh"
    source "$REPO_ROOT/modules/git/hooks.sh"
}
teardown() { common_teardown; }

@test "git preserves a dangling private-config link instead of writing into its target" {
    local target="$ENVUP_HOME/private.gitconfig"
    ln -s "$target" "$HOME/.gitconfig.local"
    run post_install
    [ "$status" -eq 0 ]
    [ -L "$HOME/.gitconfig.local" ]
    [ ! -e "$target" ]
    [[ "$output" != *"created $HOME/.gitconfig.local"* ]]
}

@test "git private-config write failure cannot report a created identity" {
    stub_bin cat <<'EOF'
#!/bin/bash
exit 1
EOF
    hash -r
    [ "$(command -v cat)" = "$STUB_BIN/cat" ]
    run post_install
    [ "$status" -eq 1 ]
    [[ "$output" != *"created $HOME/.gitconfig.local"* ]]
}

@test "the shared config names no editor" {
    # A committed guess is wrong on some machine, and it is wrong at exactly the
    # moment you least want it: mid-commit. 30-env.zsh picks from what exists.
    ! grep -Eq '^[[:space:]]*editor[[:space:]]*=' "$GITCFG"
}

@test "the shared config names no diff or merge tool" {
    # vimdiff on a machine with neither vim nor nvim turns `git mergetool` into
    # an error at the worst possible time.
    ! grep -Eq '^[[:space:]]*(tool|guitool)[[:space:]]*=' "$GITCFG"
}

@test "the shared config names no pager binary" {
    # delta belongs in the generated layer, where its absence is a fact rather
    # than a promise. A .gitconfig that pipes every diff into a missing binary
    # is a git that cannot show you a diff.
    ! grep -Eq '^[[:space:]]*(diffFilter|pager|diff|log|reflog|show)[[:space:]]*=.*delta' "$GITCFG"
}

@test "conflictstyle and colorMoved stay — they need no binary" {
    grep -q 'conflictstyle = diff3' "$GITCFG"
    grep -q 'colorMoved = default' "$GITCFG"
}

# ---- the generated layer -------------------------------------------------

@test "delta is enabled when it is actually installed" {
    stub_bin delta <<'EOF'
#!/bin/bash
echo "delta 0.17.0"
EOF
    run _git_write_generated
    [ "$status" -eq 0 ]
    grep -q '\[pager\]' "$GENERATED"
    grep -q 'diff = .*delta' "$GENERATED"
    grep -q 'diffFilter = .*delta --color-only' "$GENERATED"
}

@test "the generated file records an absolute path, not a bare name" {
    # git runs the pager through the shell, but a login shell's PATH is not the
    # PATH envup installed under — ~/.local/bin in particular. Resolving now
    # means the setting still works from a GUI client or a cron job.
    stub_bin delta <<'EOF'
#!/bin/bash
echo "delta 0.17.0"
EOF
    _git_write_generated
    grep -Eq 'diff = /' "$GENERATED"
}

@test "no delta means no pager section at all" {
    isolate_path                       # delta is not in the minimum set
    run _git_write_generated
    [ "$status" -eq 0 ]
    [ -f "$GENERATED" ]                # written, so a stale one is overwritten
    ! grep -q 'pager' "$GENERATED"
    ! grep -q 'diffFilter' "$GENERATED"
}

@test "a machine that loses delta loses the setting too" {
    # The file is rewritten every install, not appended to. Otherwise removing
    # delta leaves a .gitconfig.envup that breaks every diff.
    stub_bin delta <<'EOF'
#!/bin/bash
echo "delta 0.17.0"
EOF
    _git_write_generated
    grep -q 'delta' "$GENERATED"

    rm -f "$STUB_BIN/delta"
    isolate_path
    _git_write_generated
    ! grep -q 'delta' "$GENERATED"
}

@test "the generated file says not to edit it, and where to go instead" {
    isolate_path
    _git_write_generated
    grep -q 'Generated by' "$GENERATED"
    grep -q 'hosts/' "$GENERATED"
    grep -q 'gitconfig.local' "$GENERATED"
}

@test "the generated file is valid git config" {
    stub_bin delta <<'EOF'
#!/bin/bash
echo "delta 0.17.0"
EOF
    _git_write_generated
    run git config --file "$GENERATED" --list
    [ "$status" -eq 0 ]
    [[ "$output" == *"pager.diff="* ]]
}

@test "dry-run writes nothing" {
    stub_bin delta <<'EOF'
#!/bin/bash
echo "delta 0.17.0"
EOF
    ENVUP_DRY_RUN=1 run _git_write_generated
    [ "$status" -eq 0 ]
    [ ! -e "$GENERATED" ]
    [[ "$output" == *"dry-run"* ]]
}

@test "uninstall takes the generated file with it" {
    # envup wrote it, so envup owns it; leaving it behind would keep pointing a
    # removed setup's pager at a binary this machine may not keep.
    isolate_path
    _git_write_generated
    [ -f "$GENERATED" ]
    run post_uninstall
    [ "$status" -eq 0 ]
    [ ! -e "$GENERATED" ]
}

@test "Git backs up an existing unrecorded config before generating defaults" {
    printf '[core]\n\tpager = cat\n' > "$GENERATED"
    run _git_write_generated
    [ "$status" -eq 0 ]
    [ "$(cat "$(backup_path "$GENERATED")")" = $'[core]\n\tpager = cat' ]
    cmp "$GENERATED" "$ENVUP_STATE_DIR/git-generated"
    run _git_write_generated
    [ "$status" -eq 0 ]
    [ "$(cat "$(backup_path "$GENERATED")")" = $'[core]\n\tpager = cat' ]
}

@test "Git preserves unrecorded legacy output on uninstall regardless of its header" {
    printf "# Generated by 'envup install git' — do not edit, it is rewritten\n" > "$GENERATED"
    cp "$GENERATED" "$TEST_TMP/before"
    run post_uninstall
    [ "$status" -eq 0 ]
    cmp "$GENERATED" "$TEST_TMP/before"
}

@test "Git uninstall preserves user edits including an added trailing newline" {
    _git_write_generated
    printf '\n' >> "$GENERATED"
    cp "$GENERATED" "$TEST_TMP/before"
    run post_uninstall
    [ "$status" -eq 0 ]
    cmp "$GENERATED" "$TEST_TMP/before"
}

@test "Git backs up modified generated output before a new install" {
    _git_write_generated
    printf '[user]\n\tname = private\n' >> "$GENERATED"
    cp "$GENERATED" "$TEST_TMP/before"
    run _git_write_generated
    [ "$status" -eq 0 ]
    cmp "$(backup_path "$GENERATED")" "$TEST_TMP/before"
    cmp "$GENERATED" "$ENVUP_STATE_DIR/git-generated"
}

@test "Git refuses a backup conflict without changing generated or recorded content" {
    _git_write_generated
    printf 'private edit\n' >> "$GENERATED"
    cp "$GENERATED" "$TEST_TMP/before"
    cp "$ENVUP_STATE_DIR/git-generated" "$TEST_TMP/record-before"
    mkdir -p "$(dirname "$(backup_path "$GENERATED")")"
    printf 'previous backup\n' > "$(backup_path "$GENERATED")"
    run _git_write_generated
    [ "$status" -eq 1 ]
    cmp "$GENERATED" "$TEST_TMP/before"
    cmp "$ENVUP_STATE_DIR/git-generated" "$TEST_TMP/record-before"
    [ "$(cat "$(backup_path "$GENERATED")")" = 'previous backup' ]
}

@test "Git dry-run does not generate, back up or record an existing config" {
    printf 'private pager\n' > "$GENERATED"
    export ENVUP_DRY_RUN=1
    run _git_write_generated
    [ "$status" -eq 0 ]
    [ "$(cat "$GENERATED")" = 'private pager' ]
    [ ! -e "$ENVUP_STATE_DIR/git-generated" ]
    [ ! -e "$ENVUP_BACKUP_DIR" ]
}

@test "Git uninstall preserves replacement symlinks and directories" {
    _git_write_generated
    mv "$GENERATED" "$TEST_TMP/shared"
    ln -s "$TEST_TMP/shared" "$GENERATED"
    run post_uninstall
    [ "$status" -eq 0 ]
    [ -L "$GENERATED" ]
    [ -f "$TEST_TMP/shared" ]
    rm "$GENERATED"
    mkdir "$GENERATED"
    run post_uninstall
    [ "$status" -eq 0 ]
    [ -d "$GENERATED" ]
}

@test "Git failed activation restores the backed-up user config" {
    printf 'private pager\n' > "$GENERATED"
    export GIT_TEST_MV="$(command -v mv)"
    stub_bin mv <<'EOF'
#!/bin/bash
[[ "$1" == */git-config.* ]] && exit 1
exec "$GIT_TEST_MV" "$@"
EOF
    hash -r
    run _git_write_generated
    [ "$status" -eq 1 ]
    [ "$(cat "$GENERATED")" = 'private pager' ]
    [ ! -e "$ENVUP_STATE_DIR/git-generated" ]
}

@test "Git uninstall removal errors retain its manifest and generated record" {
    _git_write_generated
    mkdir -p "$ENVUP_HOME/modules/git"
    cp "$REPO_ROOT/modules/git/hooks.sh" "$ENVUP_HOME/modules/git/hooks.sh"
    printf 'NAME=git\n' > "$ENVUP_HOME/modules/git/meta.sh"
    manifest_add git
    export GIT_TEST_RM="$(command -v rm)"
    stub_bin rm <<'EOF'
#!/bin/bash
[[ "${@: -1}" == "$HOME/.gitconfig.envup" ]] && exit 1
exec "$GIT_TEST_RM" "$@"
EOF
    hash -r
    run engine_uninstall git
    [ "$status" -eq 1 ]
    manifest_has git
    cmp "$GENERATED" "$ENVUP_STATE_DIR/git-generated"
    rm "$STUB_BIN/rm"
    hash -r
    run engine_uninstall git
    [ "$status" -eq 0 ]
    [ ! -e "$GENERATED" ]
    [ ! -e "$ENVUP_STATE_DIR/git-generated" ]
}

@test "Git refuses a redirected generated-content record before changing user config" {
    mkdir -p "$ENVUP_STATE_DIR"
    printf 'private pager\n' > "$GENERATED"
    ln -s "$ENVUP_HOME/shared-record" "$ENVUP_STATE_DIR/git-generated"
    run _git_write_generated
    [ "$status" -eq 1 ]
    [ "$(cat "$GENERATED")" = 'private pager' ]
    [ ! -e "$ENVUP_HOME/shared-record" ]
}

@test "Git preparation failure preserves user config without creating an ownership record" {
    printf 'private pager\n' > "$GENERATED"
    stub_bin cp <<'EOF'
#!/bin/bash
exit 1
EOF
    hash -r
    run _git_write_generated
    [ "$status" -eq 1 ]
    [ "$(cat "$GENERATED")" = 'private pager' ]
    [ ! -e "$ENVUP_STATE_DIR/git-generated" ]
    [ ! -e "$ENVUP_BACKUP_DIR" ]
}

@test "Git record activation failure is reported and uninstall preserves unrecorded output" {
    export GIT_TEST_MV="$(command -v mv)"
    stub_bin mv <<'EOF'
#!/bin/bash
[[ "$1" == */git-record.* ]] && exit 1
exec "$GIT_TEST_MV" "$@"
EOF
    hash -r
    run _git_write_generated
    [ "$status" -eq 1 ]
    [ -f "$GENERATED" ]
    [ ! -e "$ENVUP_STATE_DIR/git-generated" ]
    cp "$GENERATED" "$TEST_TMP/before"
    run post_uninstall
    [ "$status" -eq 0 ]
    cmp "$GENERATED" "$TEST_TMP/before"
}

@test "Git does not uninstall defaults recorded by another checkout sharing the state directory" {
    _git_write_generated
    local checkout="$ENVUP_HOME"
    export ENVUP_HOME="$TEST_TMP/other-checkout"
    run _git_write_generated
    [ "$status" -eq 0 ]
    cp "$GENERATED" "$TEST_TMP/other-output"
    export ENVUP_HOME="$checkout"
    run post_uninstall
    [ "$status" -eq 0 ]
    cmp "$GENERATED" "$TEST_TMP/other-output"
}

@test "uninstall leaves the layers it did not write" {
    printf '[user]\n\temail = me@example.com\n' > "$HOME/.gitconfig.local"
    printf '[core]\n\tpager = cat\n' > "$HOME/.gitconfig.host"
    post_uninstall
    [ -f "$HOME/.gitconfig.local" ]
    [ -f "$HOME/.gitconfig.host" ]
}

@test "dry-run uninstall removes nothing" {
    isolate_path
    _git_write_generated
    ENVUP_DRY_RUN=1 run post_uninstall
    [ -f "$GENERATED" ]
}

@test "install writes the generated layer before anything else needs it" {
    stub_bin delta <<'EOF'
#!/bin/bash
echo "delta 0.17.0"
EOF
    run post_install
    [ "$status" -eq 0 ]
    [ -f "$GENERATED" ]
}

@test "the generated layer is the weakest of the three" {
    # envup's detection is a default; a host file and a private file are
    # decisions, and both must be able to overrule it.
    local h="$TEST_TMP/githome"; mkdir -p "$h"
    cp "$GITCFG" "$h/.gitconfig"
    printf '[pager]\n\tdiff = delta\n' > "$h/.gitconfig.envup"
    printf '[pager]\n\tdiff = less\n'  > "$h/.gitconfig.host"

    run env HOME="$h" XDG_CONFIG_HOME="$h/xdg" git config --get pager.diff
    [ "$status" -eq 0 ]
    [ "$output" = "less" ]
}

@test "standalone delta preserves pager settings even when the git module exists" {
    ln -s "$REPO_ROOT/modules/git" "$ENVUP_HOME/modules/git"
    printf 'private pager\n' > "$GENERATED"
    source "$REPO_ROOT/modules/delta/hooks.sh"
    run post_install
    [ "$status" -eq 0 ]
    [ "$(cat "$GENERATED")" = 'private pager' ]
}

@test "delta refreshes managed Git defaults and private overrides still win" {
    ln -s "$REPO_ROOT/modules/git" "$ENVUP_HOME/modules/git"
    ln -s "$GITCFG" "$HOME/.gitconfig"
    manifest_add git
    printf '[pager]\n\tdiff = cat\n' > "$HOME/.gitconfig.local"
    stub_bin delta <<'EOF'
#!/bin/bash
echo "delta 0.17.0"
EOF
    source "$REPO_ROOT/modules/delta/hooks.sh"
    run post_install
    [ "$status" -eq 0 ]
    grep -q 'diff = .*delta' "$GENERATED"
    cp "$GENERATED" "$TEST_TMP/first-generated"
    post_install
    cmp "$GENERATED" "$TEST_TMP/first-generated"
    run git config --global --includes --get pager.diff
    [ "$status" -eq 0 ]
    [ "$output" = cat ]
}

@test "delta does not rewrite pager settings after managed Git config is replaced" {
    ln -s "$REPO_ROOT/modules/git" "$ENVUP_HOME/modules/git"
    manifest_add git
    printf 'private git\n' > "$HOME/.gitconfig"
    printf 'private pager\n' > "$GENERATED"
    source "$REPO_ROOT/modules/delta/hooks.sh"
    run post_install
    [ "$status" -eq 0 ]
    [ "$(cat "$HOME/.gitconfig")" = 'private git' ]
    [ "$(cat "$GENERATED")" = 'private pager' ]
}

@test "delta refuses a generated-config symlink without changing its target" {
    ln -s "$REPO_ROOT/modules/git" "$ENVUP_HOME/modules/git"
    ln -s "$GITCFG" "$HOME/.gitconfig"
    manifest_add git
    printf 'shared content\n' > "$TEST_TMP/shared"
    ln -s "$TEST_TMP/shared" "$GENERATED"
    source "$REPO_ROOT/modules/delta/hooks.sh"
    run post_install
    [ "$status" -eq 1 ]
    [ "$(cat "$TEST_TMP/shared")" = 'shared content' ]
    [ -L "$GENERATED" ]
}

@test "git post_install propagates generated-config write errors" {
    mkdir "$GENERATED"
    run post_install
    [ "$status" -eq 1 ]
    [ ! -e "$HOME/.gitconfig.local" ]
}
